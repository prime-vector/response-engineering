# Task board credentials and local working notes. This repo goes public;
# neither the key nor pipeline detail may ever enter history.
.env
CLAUDE.local.md

# Python bytecode. The mock and the corpus tools get imported by anything
# that drives them, and a committed cache is a stale copy of a generator.
__pycache__/
*.pyc

# The adapter's audit log from a judgement sweep. Its contents are already in
# the run record, by id and count, and the log itself is per run rather than
# per artefact.
evals/results/.logs/
