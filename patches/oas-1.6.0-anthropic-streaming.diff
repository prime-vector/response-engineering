+# Streaming. Without it the provider posts and then waits for the whole
+# generation to arrive as one body, and a long one can be lost in transit: on
+# 23 Aug 2026 four consecutive commander `assess` runs died with "Remote end
+# closed connection without response", minutes into a request the same call
+# had completed twice earlier that day, while the identical request with
+# `stream: true` returned a complete board in 79 seconds. Nothing tells that
+# apart from a real failure at the exit status, and it costs the whole run.
+#
+# The events are reassembled into the response dict the non-streaming path
+# returns, so nothing downstream changes: same content blocks, same
+# stop_reason, same usage, cache fields included. This changes how the bytes
+# arrive and never what they say.
+#
+# Off with intelligence.config.stream: false.
+
+
+def _sse_events(resp: Any) -> Iterator[dict[str, Any]]:
+    """Yield the decoded payload of each SSE `data:` line.
+
+    Anthropic sends one complete JSON object per data line, `ping` events
+    included, and everything else on the wire is a comment or an `event:`
+    label this does not need. So a `data:` line that will not parse is not
+    noise to step over: it is content that did not arrive. Skipping it would
+    drop text out of the middle of a generation and leave a response that
+    still has blocks, still passes every shape check, and is quietly missing
+    part of what the model said. That is the same fail-open the runner already
+    has on truncated JSON, which this repository works around rather than
+    reproduces.
+    """
+    for raw in resp:
+        # Strict, because the non-streaming path is strict: `resp.read()
+        # .decode()` raises on invalid bytes and the request fails. Replacing
+        # them instead would put U+FFFD inside a JSON string, `json.loads`
+        # would succeed, and the caller would get a plausible message whose
+        # text or tool arguments are not what the model sent. Corruption that
+        # still parses is worse than corruption that does not.
+        try:
+            line = raw.decode("utf-8").strip()
+        except UnicodeDecodeError as exc:
+            raise ProviderError(
+                f"Anthropic stream: undecodable bytes on the wire ({exc})"
+            ) from exc
+        if not line.startswith("data:"):
+            continue
+        chunk = line[5:].strip()
+        if not chunk:
+            continue
+        try:
+            yield json.loads(chunk)
+        except json.JSONDecodeError as exc:
+            raise ProviderError(
+                f"Anthropic stream: unparseable event ({exc}): {chunk[:200]!r}"
+            ) from exc
+
+
+def _collect_stream(resp: Any) -> dict[str, Any]:
+    """Reassemble a streamed message into the non-streaming response shape."""
+    message: dict[str, Any] = {"content": [], "usage": {}}
+    blocks: dict[int, dict[str, Any]] = {}
+    partial: dict[int, list[str]] = {}
+    complete = False
+
+    for event in _sse_events(resp):
+        etype = event.get("type")
+        if etype == "message_stop":
+            complete = True
+        if etype == "error":
+            err = event.get("error") or {}
+            detail = f"{err.get('type', 'unknown')}: {err.get('message', '')}"
+            raise ProviderError(f"Anthropic stream error: {detail.strip()}")
+        if etype == "message_start":
+            start = event.get("message") or {}
+            message.update({k: v for k, v in start.items() if k != "content"})
+            message["content"] = []
+            message["usage"] = dict(start.get("usage") or {})
+        elif etype == "content_block_start":
+            index = event.get("index", len(blocks))
+            blocks[index] = dict(event.get("content_block") or {})
+            partial[index] = []
+        elif etype == "content_block_delta":
+            index = event.get("index", 0)
+            block = blocks.setdefault(index, {"type": "text", "text": ""})
+            delta = event.get("delta") or {}
+            dtype = delta.get("type")
+            if dtype == "text_delta":
+                block["text"] = block.get("text", "") + delta.get("text", "")
+            elif dtype == "thinking_delta":
+                block["thinking"] = (
+                    block.get("thinking", "") + delta.get("thinking", ""))
+            elif dtype == "signature_delta":
+                block["signature"] = (
+                    block.get("signature", "") + delta.get("signature", ""))
+            elif dtype == "input_json_delta":
+                partial.setdefault(index, []).append(delta.get("partial_json", ""))
+            else:
+                # A delta this does not know how to apply is content going on
+                # the floor. The reassembled message would still have its
+                # blocks and still pass every shape check, while differing
+                # from the response the non-streaming path would have
+                # returned, which is the one claim this patch makes. An
+                # unknown *block* type is a different matter and passes
+                # through whole, exactly as it would unstreamed.
+                raise ProviderError(
+                    f"Anthropic stream: unrecognised delta type {dtype!r} on "
+                    f"block {index}: this reassembly would silently drop it"
+                )
+        elif etype == "message_delta":
+            # stop_reason and the real output_tokens arrive here; the count in
+            # message_start is only what had been emitted by that point.
+            message.update(event.get("delta") or {})
+            message["usage"].update(event.get("usage") or {})
+
+    for index, block in sorted(blocks.items()):
+        if block.get("type") == "tool_use":
+            raw_input = "".join(partial.get(index, []))
+            # A tool call with no arguments streams no input_json_delta at all,
+            # so an empty accumulator is {} rather than a parse failure.
+            try:
+                block["input"] = json.loads(raw_input) if raw_input.strip() else {}
+            except json.JSONDecodeError as exc:
+                name = block.get("name", "?")
+                raise ProviderError(
+                    f"Anthropic stream: malformed tool input for {name}: "
+                    f"{raw_input!r}"
+                ) from exc
+        message["content"].append(block)
+
+    # A stream that closes early is the failure this whole helper exists to
+    # make visible rather than silent, and an empty content list is only its
+    # loudest form. The quiet form is worse: blocks that arrived, a plausible
+    # response shape, and `stop_reason` still None from `message_start`, which
+    # `invoke_with_tools` reads as "not a tool call" and returns as a final
+    # answer. A truncated board would then reach the runner, which exits zero
+    # on output that does not parse. `message_stop` is the last event of a
+    # finished stream, so its absence is the check that catches both.
+    if not complete:
+        raise ProviderError(
+            f"Anthropic stream ended without message_stop after "
+            f"{len(blocks)} content block(s): the generation was cut in "
+            f"transit and what arrived is partial"
+        )
+    if not message["content"]:
+        raise ProviderError("Anthropic stream ended with no content blocks")
+    return message
+
+
+def _post(
+    endpoint: str,
+    payload: dict[str, Any],
+    headers: dict[str, str],
+    timeout: int,
+    stream: bool,
+) -> dict[str, Any]:
+    """POST one message request and return the response dict, streamed or not.
+
+    Streaming matters for the timeout as much as for the transport: it applies
+    per socket read, so a long generation is no longer one silent wait that
+    either lands whole or is lost whole.
+    """
+    if stream:
+        payload = {**payload, "stream": True}
+    body = json.dumps(payload).encode()
+    req = urllib.request.Request(
+        endpoint, data=body, headers=headers, method="POST"
+    )
+    try:
+        with urllib.request.urlopen(req, timeout=timeout) as resp:
+            if stream:
+                return _collect_stream(resp)
+            return json.loads(resp.read().decode())
+    except urllib.error.HTTPError as exc:
+        detail = exc.read().decode(errors="replace")
+        raise ProviderError(f"Anthropic HTTP {exc.code}: {detail}") from exc
+    except ProviderError:
+        # Already precise about what the stream did; re-wrapping would bury it.
+        raise
+    except Exception as exc:
+        msg = scrub_secrets(str(exc), headers)
+        # `from None`, not `from exc`: see the note in openai_http.py — a chained
+        # __cause__ leaks the raw credential header in full tracebacks.
+        raise ProviderError(f"Anthropic request failed: {msg}") from None
+
