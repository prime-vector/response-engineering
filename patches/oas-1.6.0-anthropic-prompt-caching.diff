+# Prompt caching. The system prompt and the tool definitions are identical on
+# every round of a tool loop and on every run of a sweep, and without a cache
+# breakpoint they are re-sent, and re-charged, each time. A breakpoint at the
+# end of the system block covers the whole cacheable prefix, because Anthropic
+# orders it tools, then system, then messages.
+#
+# Off by setting intelligence.config.cache_prompt to false, for a caller who
+# needs byte-identical payloads to something that predates this.
+#
+# A breakpoint below the model's minimum cacheable length is not an error, it
+# simply never caches, which makes it the kind of setting that looks like a
+# saving in a diff and is not one. The minimum is in tokens and differs by
+# model; this approximates it in characters, conservatively, and the margin is
+# there because prose runs about four characters to the token and denser text
+# runs fewer. Measured against this repository's own specs, the commander's
+# system prompt is 4,333 characters and 1,018 tokens, so a flat 4,096-character
+# floor admitted a prompt the model would refuse to cache.
+_CACHE_MIN_TOKENS_DEFAULT = 1024
+_CACHE_MIN_TOKENS_HAIKU = 2048
+_CHARS_PER_TOKEN = 4
+_CACHE_MARGIN = 1.15
+
+
+def _cache_min_chars(model: str) -> int:
+    """Roughly what this model needs before a breakpoint can cache anything."""
+    minimum = (_CACHE_MIN_TOKENS_HAIKU if "haiku" in model
+               else _CACHE_MIN_TOKENS_DEFAULT)
+    return int(minimum * _CHARS_PER_TOKEN * _CACHE_MARGIN)
+
+
+def _system_field(system: str, config: dict, model: str, prefix_chars: int = 0) -> object:
+    """The `system` field, as a cached text block where that is worth doing.
+
+    Returns the plain string when caching is disabled or the prompt is too
+    short to be worth a breakpoint. The threshold is deliberately in
+    characters: the model-specific minimum is in tokens and differs per model,
+    so this approximates it conservatively rather than guessing per model. A
+    breakpoint under the minimum is not an error, it simply does not cache,
+    and this keeps the request shape unchanged in the case where the feature
+    would do nothing.
+    """
+    if not config.get("cache_prompt", True):
+        return system
+    # The minimum applies to the whole cacheable prefix, which is the tools and
+    # then the system block, not to the block being marked. Measuring the block
+    # alone declines breakpoints that would have cached: a spec with a short
+    # system prompt and substantial tool definitions clears the minimum on the
+    # pair and never on either half.
+    if len(system) + prefix_chars < _cache_min_chars(model):
+        return system
+    return [
+        {
+            "type": "text",
+            "text": system,
+            "cache_control": {"type": "ephemeral"},
+        }
+    ]
+
+
+def _prompt_turn_index(messages: list[dict[str, Any]]) -> int:
+    """Where the prompt ends: the last user turn that is not a tool result.
+
+    Not index zero, which is what this used to mark. The runner prepends any
+    supplied history before the current turn, so on that path index zero is an
+    old message and the view this exists to cache sits further down, uncached
+    on every round of the loop.
+
+    The last plain user turn is the same message on every round, which is what
+    a breakpoint needs: rounds two onward append user messages carrying
+    tool_result blocks, and those are skipped here, so the index does not move
+    and the cached prefix does not change under it.
+    """
+    for index in range(len(messages) - 1, -1, -1):
+        message = messages[index]
+        if message.get("role") != "user":
+            continue
+        content = message.get("content")
+        if isinstance(content, str):
+            return index
+        if isinstance(content, list) and not any(
+            isinstance(block, dict) and block.get("type") == "tool_result"
+            for block in content
+        ):
+            return index
+    return -1
+
+
+def _cache_first_turn(messages: list[dict[str, Any]], model: str,
+                      prefix_chars: int = 0) -> list[dict[str, Any]]:
+    """Put a second cache breakpoint at the end of the prompt's last user turn.
+
+    The system prompt is not where a tool loop spends its input. The first user
+    turn carries the incident view, and every round of the loop re-sends it
+    along with every tool result so far. Measured on this repository's own
+    specs: the recall system prompt is about 1,700 tokens against a view of
+    22,000, so a system-only breakpoint covers roughly seven per cent of a
+    request and this one covers most of the rest.
+
+    Only the first turn, and only in the tool loop. A breakpoint that moves
+    with the conversation would cache the accumulated tool results too, which
+    is worth more again and is worth measuring on its own rather than
+    inheriting from this.
+
+    An ephemeral breakpoint lives about five minutes from its last read. A loop
+    whose rounds are further apart than that pays full price again, and a sweep
+    running back to back reuses the system prefix across runs. Neither is a
+    correctness concern: a miss costs what the request cost before this.
+    """
+    index = _prompt_turn_index(messages)
+    if index < 0:
+        return messages
+    out = [dict(m) for m in messages]
+    first = out[index]
+    content = first.get("content")
+    if isinstance(content, str):
+        if len(content) + prefix_chars < _cache_min_chars(model):
+            return messages
+        first["content"] = [
+            {"type": "text", "text": content,
+             "cache_control": {"type": "ephemeral"}}
+        ]
+    elif isinstance(content, list) and content:
+        blocks = [dict(b) if isinstance(b, dict) else b for b in content]
+        if not isinstance(blocks[-1], dict):
+            return messages
+        if sum(len(str(b.get("text") or b.get("content") or "")) for b in blocks
+               if isinstance(b, dict)) + prefix_chars < _cache_min_chars(model):
+            return messages
+        blocks[-1] = dict(blocks[-1])
+        blocks[-1]["cache_control"] = {"type": "ephemeral"}
+        first["content"] = blocks
+    else:
+        return messages
+    return out
+
+
 def _supports_temperature(model: str) -> bool:
     """False for models that reject `temperature` (Opus 4.7/4.8, Fable 5)."""
     return not any(model.startswith(prefix) for prefix in _NO_SAMPLING_PARAM_MODELS)
